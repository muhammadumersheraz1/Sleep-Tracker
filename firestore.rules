rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Collection id has a space; match via path variable.
    match /{collectionId}/{logId} {
      allow read, update, delete: if collectionId == 'sleeping logs'
        && request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if collectionId == 'sleeping logs'
        && request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'userId', 'sleepAt', 'wakeAt', 'note', 'createdAt', 'updatedAt'
        ]);
    }
  }
}
